# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# On Vercel: set this in Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# Not required on Vercel — routes derive their own URL from the incoming
# request's Host header instead.
APP_URL="MY_APP_URL"

# DATABASE_URL: Postgres connection string used by Prisma (lib/prisma.ts,
# lib/db.ts). Required everywhere, including local dev — there is no
# separate "local" vs "production" database implementation, just this one
# connection string pointing at different instances.
#
# If you're using Prisma Postgres (https://www.prisma.io/postgres), copy
# the "Direct connection" string from your project's dashboard — NOT the
# "prisma+postgres://" Accelerate-pooled string, which is a proprietary
# proxy protocol @prisma/adapter-pg (lib/prisma.ts) can't dial directly.
# Any other standard Postgres works too (local, Neon, Supabase, RDS, ...).
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# GEMINI_WEBHOOK_SECRET / BYPASS_SIGNATURE: see lib/signature.ts. Only
# needed if you're using the managed background-agent models and want
# webhook signature verification in a non-development environment.
GEMINI_WEBHOOK_SECRET=""
